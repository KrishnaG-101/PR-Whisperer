      "id": 100,
      "title": "PR-Whisperer Voice & Observability Telemetry Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "lineWidth": 1 },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(pr_whisperer_requests_total)",
          "legendFormat": "Total Requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Total HTTP Requests",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(pr_whisperer_voice_analyze_errors_total) or vector(0)",
          "legendFormat": "Voice Analyze Failures",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Voice Pipeline Errors",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "ALERTS{alertname=\"HighVoiceAnalyzeFailureRate\", alertstate=\"firing\"} or vector(0)",
          "legendFormat": "Active User-Impact Alerts",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active User-Impact Alerts",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(pr_whisperer_request_duration_seconds_sum[1m]) / rate(pr_whisperer_request_duration_seconds_count[1m]) or vector(0.05)",
          "legendFormat": "Avg Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Average Request Latency",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests / Sec",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineWidth": 2
          }
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(pr_whisperer_requests_total[1m])",
          "legendFormat": "{{method}} {{endpoint}} ({{status_code}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API Request Throughput by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Errors",
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1
          }
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "increase(pr_whisperer_voice_analyze_errors_total[1m])",
          "legendFormat": "PR: {{pr_id}} ({{alert_type}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Voice Ingestion Failures & Incident Spike",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
