# PR-Whisperer Environment Variables
# ==============================================================================

# 1. Gemini REST API Key (Optional - Fallback Engine automatically engages if unset)
GEMINI_API_KEY=your_gemini_api_key_here_optional_fallback_enabled

# 2. Database Connection URL
# Local SQLite development default:
DATABASE_URL=sqlite:///./pr_whisperer.db
# Docker Compose PostgreSQL default:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/pr_whisperer

# 3. Frontend API Base URL
VITE_API_URL=http://localhost:8000

# 4. Observability & Logging Configuration
APP_ENV=development
LOG_LEVEL=INFO
